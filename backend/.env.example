# PostgreSQL (local install). Change the password/database to match yours.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/job_app_automation?schema=public"

# Ollama (local)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_TIMEOUT_MS=180000

# Server
PORT=5871
HOST=127.0.0.1
FRONTEND_URL=http://localhost:5870

# Local CV storage (relative to the backend folder, or absolute)
CV_STORAGE_PATH=./storage/cvs

# Shared secret between frontend and backend (filled in by `npm run init-env`).
# Must equal VITE_API_TOKEN in frontend/.env
API_TOKEN=

# Encrypts stored Gmail OAuth tokens at rest (filled in by `npm run init-env`)
TOKEN_ENCRYPTION_KEY=

# Gmail OAuth client (Google Cloud Console -> Credentials -> OAuth client, type "Web application")
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=http://localhost:5871/api/email/oauth/callback
