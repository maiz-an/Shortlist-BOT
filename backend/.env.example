# PostgreSQL (local install). Change the password/database to match yours.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/job_app_automation?schema=public"

# Which AI answers job-matching and email questions: "ollama" (default, local and free) or
# "openai" (any cloud API that speaks the OpenAI chat format - OpenAI, OpenRouter, Groq, Together.ai, ...).
AI_PROVIDER=ollama

# Ollama (used when AI_PROVIDER=ollama). Pick a model that fits your RAM - see SETUP.md.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_TIMEOUT_MS=180000

# Cloud AI (used when AI_PROVIDER=openai). AI_API_BASE_URL defaults to OpenAI itself; point it at
# any other OpenAI-compatible provider instead, e.g. https://openrouter.ai/api/v1 or https://api.groq.com/openai/v1.
# AI_API_BASE_URL=https://api.openai.com/v1
# AI_API_KEY=
# AI_API_MODEL=gpt-4o-mini
# AI_API_TIMEOUT_MS=120000

# Server
PORT=5871
HOST=127.0.0.1
FRONTEND_URL=http://localhost:5870

# Local CV storage (relative to the backend folder, or absolute)
CV_STORAGE_PATH=./storage/cvs

# Shared secret between frontend and backend (filled in by `npm run init-env`).
# Must equal VITE_API_TOKEN in frontend/.env
API_TOKEN=

# Optional login for the web app. REQUIRED before you let anything other than this computer reach it
# (phone over Tailscale/LAN, a tunnel, ...). Leave empty for localhost-only use. Use a long passphrase.
ACCESS_PASSCODE=

# Encrypts stored Gmail OAuth tokens at rest (filled in by `npm run init-env`)
TOKEN_ENCRYPTION_KEY=

# Gmail OAuth client (Google Cloud Console -> Credentials -> OAuth client, type "Web application")
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=http://localhost:5871/api/email/oauth/callback

# Optional: Indeed source (needs `pip install python-jobspy`, see SETUP.md)
# INDEED_COUNTRY=Qatar
# PYTHON_BIN=python

# Optional: GulfTalent source through Apify (free account: https://console.apify.com/account/integrations)
# APIFY_TOKEN=
# APIFY_GULFTALENT_ACTOR=blackfalcondata~gulftalent-scraper
# APIFY_COUNTRY=QA

# Optional: WhatsApp alerts through a self-hosted OpenWA instance (see SETUP.md, services/openwa)
# OPENWA_URL=http://127.0.0.1:2785
# OPENWA_API_KEY=
# OPENWA_SESSION_NAME=shortlist-alerts
